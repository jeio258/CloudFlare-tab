{
  "name": "cloudflare-tab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.functions.json",
    "test": "node tests/e2e.mjs",
    "test:e2e": "node tests/e2e-mobile.mjs",
    "dev:cf": "wrangler pages dev dist --local",
    "deploy": "vite build && wrangler pages deploy dist --project-name cloudflare-tab --branch master",
    "deploy:pages": "npm run build && npm run db:migrate && wrangler pages deploy dist --project-name cloudflare-tab --branch master",
    "deploy:workers": "npm run build && npm run db:migrate && wrangler deploy -c wrangler.workers.toml",
    "db:migrate": "wrangler d1 execute cloudflare-tab-db --remote --file schema.sql",
    "db:migrate:local": "wrangler d1 execute cloudflare-tab-db --local --file schema.sql",
    "account:create": "node scripts/create-account.mjs"
  },
  "dependencies": {
    "antd": "^5.24.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
